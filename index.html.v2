<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>FIF STUDIO 🔥 Forged in Fire | Únete al equipo</title>
<meta name="description" content="Estudio indie de videojuegos buscando jóvenes cubanos apasionados. Programación, arte, diseño y más.">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Orbitron:wght@700;900&family=Rajdhani:wght@400;600;700&display=swap" rel="stylesheet">
<style>
  * { margin: 0; padding: 0; box-sizing: border-box; }
  
  :root {
    --fire1: #ff4500;
    --fire2: #ff6b35;
    --fire3: #f7931e;
    --fire4: #ffcc00;
    --dark1: #0a0a15;
    --dark2: #13132b;
    --dark3: #1a1a3e;
    --text: #eaeaea;
    --text-dim: #a0a0c0;
  }

  html { scroll-behavior: smooth; }

  body {
    font-family: 'Rajdhani', sans-serif;
    background: var(--dark1);
    color: var(--text);
    min-height: 100vh;
    overflow-x: hidden;
    position: relative;
  }

  /* Fondo animado con partículas de fuego */
  .bg-fire {
    position: fixed;
    top: 0; left: 0; right: 0; bottom: 0;
    z-index: -1;
    background: 
      radial-gradient(ellipse at 20% 0%, rgba(255,69,0,0.15) 0%, transparent 50%),
      radial-gradient(ellipse at 80% 100%, rgba(247,147,30,0.12) 0%, transparent 50%),
      radial-gradient(ellipse at 50% 50%, rgba(255,204,0,0.05) 0%, transparent 70%),
      linear-gradient(135deg, #0a0a15 0%, #13132b 50%, #1a1a3e 100%);
  }
  
  .bg-fire::before {
    content: '';
    position: absolute;
    inset: 0;
    background-image: 
      radial-gradient(2px 2px at 20% 30%, rgba(255,107,53,0.6), transparent),
      radial-gradient(2px 2px at 60% 70%, rgba(255,204,0,0.5), transparent),
      radial-gradient(1px 1px at 40% 80%, rgba(255,69,0,0.7), transparent),
      radial-gradient(1px 1px at 80% 20%, rgba(247,147,30,0.6), transparent),
      radial-gradient(2px 2px at 10% 60%, rgba(255,107,53,0.4), transparent),
      radial-gradient(1px 1px at 90% 40%, rgba(255,204,0,0.5), transparent);
    animation: sparkle 8s ease-in-out infinite alternate;
  }

  @keyframes sparkle {
    0%   { opacity: 0.3; transform: translateY(0); }
    100% { opacity: 0.9; transform: translateY(-15px); }
  }

  /* HEADER / HERO */
  .hero {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 40px 20px;
    text-align: center;
    position: relative;
  }

  .logo-container {
    position: relative;
    margin-bottom: 20px;
    animation: float 3s ease-in-out infinite;
  }

  @keyframes float {
    0%, 100% { transform: translateY(0); }
    50%      { transform: translateY(-10px); }
  }

  .logo-fire {
    font-size: 5em;
    line-height: 1;
    filter: drop-shadow(0 0 20px rgba(255,107,53,0.8)) 
            drop-shadow(0 0 40px rgba(255,69,0,0.5));
    animation: flicker 2s infinite alternate;
  }

  @keyframes flicker {
    0%   { filter: drop-shadow(0 0 20px rgba(255,107,53,0.8)) drop-shadow(0 0 40px rgba(255,69,0,0.5)); }
    50%  { filter: drop-shadow(0 0 30px rgba(255,204,0,0.9)) drop-shadow(0 0 60px rgba(255,69,0,0.7)); }
    100% { filter: drop-shadow(0 0 20px rgba(255,107,53,0.8)) drop-shadow(0 0 40px rgba(255,69,0,0.5)); }
  }

  .title {
    font-family: 'Orbitron', sans-serif;
    font-size: clamp(2.5em, 8vw, 5em);
    font-weight: 900;
    letter-spacing: 4px;
    background: linear-gradient(135deg, #ff4500 0%, #ff6b35 30%, #f7931e 60%, #ffcc00 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    text-shadow: 0 0 60px rgba(255,107,53,0.5);
    margin-bottom: 10px;
    animation: glow 3s ease-in-out infinite;
  }

  @keyframes glow {
    0%, 100% { filter: brightness(1); }
    50%      { filter: brightness(1.2); }
  }

  .subtitle {
    font-size: clamp(1em, 3vw, 1.4em);
    color: var(--text-dim);
    font-style: italic;
    letter-spacing: 2px;
    margin-bottom: 30px;
    font-weight: 600;
  }

  .subtitle .fire-emoji {
    display: inline-block;
    animation: shake 1.5s ease-in-out infinite;
  }

  @keyframes shake {
    0%, 100% { transform: rotate(-5deg); }
    50%      { transform: rotate(5deg); }
  }

  .cta-buttons {
    display: flex;
    gap: 15px;
    flex-wrap: wrap;
    justify-content: center;
    margin-top: 20px;
  }

  .btn {
    padding: 15px 40px;
    font-family: 'Orbitron', sans-serif;
    font-size: 0.9em;
    font-weight: 700;
    letter-spacing: 2px;
    border: none;
    border-radius: 50px;
    cursor: pointer;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 10px;
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    position: relative;
    overflow: hidden;
  }

  .btn-primary {
    background: linear-gradient(135deg, var(--fire1), var(--fire3));
    color: white;
    box-shadow: 0 8px 30px rgba(255,107,53,0.4), 
                inset 0 1px 0 rgba(255,255,255,0.2);
  }

  .btn-primary:hover {
    transform: translateY(-3px) scale(1.05);
    box-shadow: 0 15px 40px rgba(255,107,53,0.6),
                inset 0 1px 0 rgba(255,255,255,0.3);
  }

  .btn-primary::before {
    content: '';
    position: absolute;
    top: 0; left: -100%;
    width: 100%; height: 100%;
    background: linear-gradient(90deg, transparent, rgba(255,255,255,0.3), transparent);
    transition: left 0.5s;
  }

  .btn-primary:hover::before { left: 100%; }

  .btn-ghost {
    background: transparent;
    color: var(--text);
    border: 2px solid rgba(255,107,53,0.5);
  }

  .btn-ghost:hover {
    border-color: var(--fire2);
    background: rgba(255,107,53,0.1);
    transform: translateY(-3px);
  }

  /* SCROLL INDICATOR */
  .scroll-down {
    position: absolute;
    bottom: 30px;
    left: 50%;
    transform: translateX(-50%);
    color: var(--text-dim);
    font-size: 0.85em;
    letter-spacing: 2px;
    animation: bounce 2s infinite;
  }

  @keyframes bounce {
    0%, 100% { transform: translateX(-50%) translateY(0); }
    50%      { transform: translateX(-50%) translateY(-10px); }
  }

  .scroll-arrow {
    font-size: 1.5em;
    display: block;
    margin-top: 5px;
  }

  /* SECCIONES */
  section {
    padding: 80px 20px;
    max-width: 1100px;
    margin: 0 auto;
    position: relative;
  }

  .section-title {
    font-family: 'Orbitron', sans-serif;
    font-size: clamp(1.8em, 4vw, 2.5em);
    font-weight: 700;
    text-align: center;
    margin-bottom: 15px;
    letter-spacing: 3px;
    color: var(--text);
  }

  .section-title .accent {
    color: var(--fire2);
    text-shadow: 0 0 20px rgba(255,107,53,0.5);
  }

  .section-subtitle {
    text-align: center;
    color: var(--text-dim);
    margin-bottom: 50px;
    font-size: 1.1em;
    letter-spacing: 1px;
  }

  /* CARDS DE INFO */
  .cards-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 25px;
    margin-top: 40px;
  }

  .card {
    background: linear-gradient(135deg, rgba(255,255,255,0.05), rgba(255,255,255,0.02));
    border: 1px solid rgba(255,107,53,0.2);
    border-radius: 20px;
    padding: 30px 25px;
    text-align: center;
    transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
    position: relative;
    overflow: hidden;
    backdrop-filter: blur(10px);
  }

  .card::before {
    content: '';
    position: absolute;
    top: 0; left: 0; right: 0;
    height: 3px;
    background: linear-gradient(90deg, var(--fire1), var(--fire3), var(--fire4));
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.4s;
  }

  .card:hover {
    transform: translateY(-8px);
    border-color: var(--fire2);
    box-shadow: 0 20px 50px rgba(255,107,53,0.25);
  }

  .card:hover::before {
    transform: scaleX(1);
  }

  .card-icon {
    font-size: 3em;
    margin-bottom: 15px;
    display: block;
    filter: drop-shadow(0 0 15px rgba(255,107,53,0.6));
  }

  .card h3 {
    font-family: 'Orbitron', sans-serif;
    font-size: 1.1em;
    letter-spacing: 1.5px;
    margin-bottom: 12px;
    color: var(--fire3);
  }

  .card p {
    color: var(--text-dim);
    line-height: 1.6;
    font-size: 0.95em;
  }

  /* AREAS TAGS */
  .areas-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(150px, 1fr));
    gap: 15px;
    margin-top: 30px;
  }

  .area-tag {
    background: rgba(255,107,53,0.08);
    border: 1px solid rgba(255,107,53,0.3);
    border-radius: 12px;
    padding: 18px 12px;
    text-align: center;
    transition: all 0.3s;
    cursor: default;
    font-weight: 600;
    letter-spacing: 0.5px;
  }

  .area-tag:hover {
    background: rgba(255,107,53,0.15);
    border-color: var(--fire2);
    transform: translateY(-3px) scale(1.03);
    box-shadow: 0 8px 20px rgba(255,107,53,0.2);
  }

  .area-tag .emoji {
    display: block;
    font-size: 1.8em;
    margin-bottom: 8px;
  }

  /* FORMULARIO */
  .form-container {
    background: linear-gradient(135deg, rgba(255,255,255,0.06), rgba(255,255,255,0.02));
    border: 1px solid rgba(255,107,53,0.25);
    border-radius: 24px;
    padding: 40px 30px;
    backdrop-filter: blur(15px);
    box-shadow: 0 20px 60px rgba(0,0,0,0.4);
    position: relative;
    overflow: hidden;
  }

  .form-container::before {
    content: '';
    position: absolute;
    top: 0; left: 0; right: 0;
    height: 4px;
    background: linear-gradient(90deg, var(--fire1), var(--fire3), var(--fire4), var(--fire3), var(--fire1));
    background-size: 200% 100%;
    animation: gradientMove 3s linear infinite;
  }

  @keyframes gradientMove {
    0%   { background-position: 0% 0; }
    100% { background-position: 200% 0; }
  }

  .form-group {
    margin-bottom: 20px;
    position: relative;
  }

  .form-group label {
    display: block;
    margin-bottom: 8px;
    font-weight: 600;
    letter-spacing: 0.5px;
    color: var(--text);
    font-size: 0.95em;
  }

  .form-group label .req {
    color: var(--fire2);
    margin-left: 3px;
  }

  .form-group input,
  .form-group select,
  .form-group textarea {
    width: 100%;
    padding: 14px 16px;
    border: 2px solid rgba(255,255,255,0.1);
    border-radius: 12px;
    background: rgba(0,0,0,0.4);
    color: white;
    font-size: 1em;
    font-family: inherit;
    transition: all 0.3s;
  }

  .form-group input:focus,
  .form-group select:focus,
  .form-group textarea:focus {
    outline: none;
    border-color: var(--fire2);
    background: rgba(0,0,0,0.6);
    box-shadow: 0 0 0 4px rgba(255,107,53,0.15), 0 0 20px rgba(255,107,53,0.2);
    transform: translateY(-1px);
  }

  .form-group textarea {
    resize: vertical;
    min-height: 110px;
  }

  .form-group select option {
    background: var(--dark2);
    color: white;
  }

  .form-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 15px;
  }

  @media (max-width: 600px) {
    .form-row { grid-template-columns: 1fr; }
  }

  .btn-submit {
    width: 100%;
    padding: 18px;
    font-family: 'Orbitron', sans-serif;
    font-size: 1.05em;
    font-weight: 900;
    letter-spacing: 3px;
    color: white;
    background: linear-gradient(135deg, var(--fire1), var(--fire3));
    border: none;
    border-radius: 14px;
    cursor: pointer;
    margin-top: 10px;
    position: relative;
    overflow: hidden;
    transition: all 0.3s;
    box-shadow: 0 10px 30px rgba(255,107,53,0.4);
  }

  .btn-submit:hover {
    transform: translateY(-3px);
    box-shadow: 0 15px 40px rgba(255,107,53,0.6);
    letter-spacing: 4px;
  }

  .btn-submit::after {
    content: '';
    position: absolute;
    top: 50%; left: 50%;
    width: 0; height: 0;
    background: rgba(255,255,255,0.3);
    border-radius: 50%;
    transform: translate(-50%, -50%);
    transition: width 0.6s, height 0.6s;
  }

  .btn-submit:hover::after {
    width: 400px;
    height: 400px;
  }

  .btn-submit span {
    position: relative;
    z-index: 1;
  }

  /* FOOTER */
  footer {
    text-align: center;
    padding: 40px 20px;
    color: var(--text-dim);
    border-top: 1px solid rgba(255,107,53,0.1);
    margin-top: 40px;
  }

  footer .footer-logo {
    font-family: 'Orbitron', sans-serif;
    font-size: 1.3em;
    font-weight: 900;
    letter-spacing: 3px;
    background: linear-gradient(135deg, var(--fire1), var(--fire4));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    margin-bottom: 10px;
  }

  footer .footer-note {
    font-size: 0.85em;
    line-height: 1.7;
    max-width: 500px;
    margin: 0 auto;
  }

  footer .footer-note strong {
    color: var(--fire3);
  }

  /* Animaciones de entrada */
  .fade-in {
    opacity: 0;
    transform: translateY(30px);
    transition: opacity 0.8s, transform 0.8s;
  }

  .fade-in.visible {
    opacity: 1;
    transform: translateY(0);
  }

  /* Responsive */
  @media (max-width: 768px) {
    section { padding: 60px 15px; }
    .form-container { padding: 30px 20px; }
    .logo-fire { font-size: 3.5em; }
  }
</style>
</head>
<body>

<div class="bg-fire"></div>

<!-- HERO -->
<div class="hero">
  <div class="logo-container">
    <div class="logo-fire">🔥</div>
  </div>
  <h1 class="title">FIF STUDIO</h1>
  <p class="subtitle">Forged in Fire <span class="fire-emoji">⚔️</span> Forjado en el fuego</p>

  <div class="cta-buttons">
    <a href="#aplicar" class="btn btn-primary">⚡ ÚNETE AL EQUIPO</a>
    <a href="#info" class="btn btn-ghost">📖 SABER MÁS</a>
  </div>

  <div class="scroll-down">
    SCROLL
    <span class="scroll-arrow">↓</span>
  </div>
</div>

<!-- INFO -->
<section id="info" class="fade-in">
  <h2 class="section-title">¿Quiénes <span class="accent">somos</span>?</h2>
  <p class="section-subtitle">Un pequeño estudio indie forjándose desde cero</p>

  <div class="cards-grid">
    <div class="card">
      <span class="card-icon">🎮</span>
      <h3>PROYECTO REAL</h3>
      <p>Estamos creando un videojuego desde cero. Tu trabajo será parte de algo real, no un ejercicio de práctica.</p>
    </div>
    <div class="card">
      <span class="card-icon">🌍</span>
      <h3>100% REMOTO</h3>
      <p>Trabajamos desde cualquier lugar de Cuba. Reuniones 1-2 veces por semana según tu área.</p>
    </div>
    <div class="card">
      <span class="card-icon">🏆</span>
      <h3>CRÉDITOS REALES</h3>
      <p>Aparecerás en los créditos del juego terminado. Perfecto para tu portafolio profesional.</p>
    </div>
    <div class="card">
      <span class="card-icon">🔥</span>
      <h3>SIN EXPERIENCIA</h3>
      <p>No importa si eres principiante. Lo que importa son las ganas de aprender y crear.</p>
    </div>
  </div>
</section>

<!-- AREAS -->
<section class="fade-in">
  <h2 class="section-title">Áreas <span class="accent">abiertas</span></h2>
  <p class="section-subtitle">Busca tu lugar en la forja</p>

  <div class="areas-grid">
    <div class="area-tag"><span class="emoji">💻</span>Programación</div>
    <div class="area-tag"><span class="emoji">🎨</span>Arte 2D</div>
    <div class="area-tag"><span class="emoji">🗿</span>Arte 3D</div>
    <div class="area-tag"><span class="emoji">🎯</span>Diseño de juego</div>
    <div class="area-tag"><span class="emoji">🎵</span>Audio</div>
    <div class="area-tag"><span class="emoji">🧪</span>QA / Testing</div>
    <div class="area-tag"><span class="emoji">📢</span>Marketing</div>
    <div class="area-tag"><span class="emoji">📝</span>Guion / Narrativa</div>
  </div>
</section>

<!-- FORMULARIO -->
<section id="aplicar" class="fade-in">
  <h2 class="section-title">Aplica <span class="accent">ahora</span></h2>
  <p class="section-subtitle">Jóvenes cubanos de 16 a 23 años · Colaboración voluntaria</p>

  <div class="form-container">
    <form action="https://formsubmit.co/maikelmplus2009@gmail.com" method="POST">
      
      <div class="form-row">
        <div class="form-group">
          <label>Nombre completo <span class="req">*</span></label>
          <input type="text" name="Nombre" required placeholder="Tu nombre y apellidos">
        </div>

        <div class="form-group">
          <label>Edad <span class="req">*</span></label>
          <input type="number" name="Edad" min="16" max="23" required placeholder="16 a 23 años">
        </div>
      </div>

      <div class="form-row">
        <div class="form-group">
          <label>Correo electrónico <span class="req">*</span></label>
          <input type="email" name="Email" required placeholder="tucorreo@ejemplo.com">
        </div>

        <div class="form-group">
          <label>Discord / Telegram <span class="req">*</span></label>
          <input type="text" name="Contacto" required placeholder="@usuario o usuario#1234">
        </div>
      </div>

      <div class="form-group">
        <label>Provincia / Ciudad <span class="req">*</span></label>
        <input type="text" name="Ubicacion" required placeholder="Ej: La Habana, Camagüey, Santiago...">
      </div>

      <div class="form-row">
        <div class="form-group">
          <label>Área de interés <span class="req">*</span></label>
          <select name="Area" required>
            <option value="">-- Selecciona --</option>
            <option value="Programación">💻 Programación</option>
            <option value="Arte 2D">🎨 Arte 2D</option>
            <option value="Arte 3D">🗿 Arte 3D</option>
            <option value="Diseño de juego">🎯 Diseño de juego</option>
            <option value="Audio">🎵 Audio</option>
            <option value="QA / Testing">🧪 QA / Testing</option>
            <option value="Marketing">📢 Marketing</option>
            <option value="Guion / Narrativa">📝 Guion / Narrativa</option>
          </select>
        </div>

        <div class="form-group">
          <label>Nivel de experiencia <span class="req">*</span></label>
          <select name="Experiencia" required>
            <option value="">-- Selecciona --</option>
            <option value="Principiante">🌱 Principiante</option>
            <option value="Intermedio">⚡ Intermedio</option>
            <option value="Avanzado">🔥 Avanzado</option>
          </select>
        </div>
      </div>

      <div class="form-row">
        <div class="form-group">
          <label>¿Tienes PC y conexión? <span class="req">*</span></label>
          <select name="Equipo" required>
            <option value="">-- Selecciona --</option>
            <option value="Sí, ambos">✅ Sí, ambos</option>
            <option value="Solo PC">💻 Solo PC/laptop</option>
            <option value="Solo móvil">📱 Solo móvil</option>
            <option value="No">❌ No por ahora</option>
          </select>
        </div>

        <div class="form-group">
          <label>Horas semanales disponibles <span class="req">*</span></label>
          <select name="Horas" required>
            <option value="">-- Selecciona --</option>
            <option value="Menos de 5">Menos de 5 horas</option>
            <option value="5 a 10">5 a 10 horas</option>
            <option value="10 a 20">10 a 20 horas</option>
            <option value="Más de 20">Más de 20 horas</option>
          </select>
        </div>
      </div>

      <div class="form-group">
        <label>Cuéntanos sobre ti <span class="req">*</span></label>
        <textarea name="Presentacion" required placeholder="¿Por qué quieres unirte a FIF STUDIO? ¿Qué sabes hacer? ¿Qué te gustaría aprender? ¿Tienes algún portafolio o proyecto previo?"></textarea>
      </div>

      <div class="form-group">
        <label>¿Cómo nos conociste? (opcional)</label>
        <input type="text" name="Como nos conociste" placeholder="Discord, amigo, Telegram...">
      </div>

      <!-- Configuración FormSubmit -->
      <input type="hidden" name="_subject" value="🔥 Nueva solicitud FIF STUDIO">
      <input type="hidden" name="_template" value="table">
      <input type="hidden" name="_captcha" value="false">
      <input type="hidden" name="_next" value="https://mplus2009.github.io/FIF-STUDIO/gracias.html">
      <input type="hidden" name="_autoresponse" value="¡Gracias por aplicar a FIF STUDIO! 🔥 Hemos recibido tu solicitud. Revisaremos tu perfil y te contactaremos pronto por Discord o correo. Mientras tanto, sigue practicando — la forja no se detiene. ⚔️ — Equipo FIF STUDIO">

      <button type="submit" class="btn-submit">
        <span>🔥 ENVIAR SOLICITUD 🔥</span>
      </button>
    </form>
  </div>
</section>

<!-- FOOTER -->
<footer>
  <div class="footer-logo">FIF STUDIO</div>
  <div class="footer-note">
    <strong>Forged in Fire</strong> ⚔️ — 2026<br>
    Colaboración voluntaria sin remuneración por el momento.<br>
    Los miembros aparecerán en los créditos del proyecto.
  </div>
</footer>

<script>
  // Animación de entrada al hacer scroll
  const observer = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (entry.isIntersecting) {
        entry.target.classList.add('visible');
      }
    });
  }, { threshold: 0.1 });

  document.querySelectorAll('.fade-in').forEach(el => observer.observe(el));

  // Efecto parallax suave en el hero
  window.addEventListener('scroll', () => {
    const scrolled = window.pageYOffset;
    const hero = document.querySelector('.hero');
    if (hero && scrolled < window.innerHeight) {
      hero.style.transform = `translateY(${scrolled * 0.3}px)`;
      hero.style.opacity = 1 - scrolled / window.innerHeight;
    }
  });

  // Efecto de partículas de fuego al mover el mouse
  document.addEventListener('mousemove', (e) => {
    if (Math.random() > 0.85) {
      const particle = document.createElement('div');
      particle.style.cssText = `
        position: fixed;
        left: ${e.clientX}px;
        top: ${e.clientY}px;
        width: 6px;
        height: 6px;
        background: radial-gradient(circle, #ffcc00, #ff4500);
        border-radius: 50%;
        pointer-events: none;
        z-index: 9999;
        box-shadow: 0 0 10px #ff6b35;
      `;
      document.body.appendChild(particle);
      
      const angle = Math.random() * Math.PI * 2;
      const velocity = 2 + Math.random() * 3;
      let posX = e.clientX;
      let posY = e.clientY;
      let opacity = 1;
      
      const animate = () => {
        posX += Math.cos(angle) * velocity;
        posY += Math.sin(angle) * velocity + 0.5;
        opacity -= 0.03;
        
        particle.style.left = posX + 'px';
        particle.style.top = posY + 'px';
        particle.style.opacity = opacity;
        
        if (opacity > 0) {
          requestAnimationFrame(animate);
        } else {
          particle.remove();
        }
      };
      
      animate();
    }
  });
</script>

</body>
</html>
